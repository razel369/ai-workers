{
  "name": "ai-workers",
  "version": "1.0.0",
  "description": "Hebrew-first AI worker marketplace for Israeli businesses, with operator-managed AI and configurable payment channels.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings server.js",
    "dev": "node --experimental-sqlite --no-warnings --watch server.js",
    "test": "node --experimental-sqlite --no-warnings run-tests.js",
    "test:api": "node --experimental-sqlite --no-warnings test.js && node --experimental-sqlite --no-warnings worker-tests.js",
    "test:browser": "node --experimental-sqlite --no-warnings browser-flow-test.js",
    "tunnel": "node bin/tunnel.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "ai-workers",
    "ai-employees",
    "marketplace",
    "israel",
    "hebrew",
    "customer-service",
    "lead-generation",
    "business"
  ],
  "license": "MIT",
  "homepage": "https://github.com/razel369/ai-workers",
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
