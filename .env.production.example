# =============================================================================
# AI Workers — Production environment template
# תבנית משתני סביבה לפרודקשן
#
# Copy to Render Dashboard → Environment (or your host's secret store).
# העתיקו ללוח הבקרה של Render → Environment (או מאגר הסודות של הספק).
# Never commit real secrets. / לעולם אל תעלו סודות אמיתיים ל-Git.
# =============================================================================

# --- Identity / זהות -------------------------------------------------------
# Operational display name used by health, order summaries, and metadata. The current
# visual landing/marketplace brand is defined in the checked-in UI assets.
# שם תפעולי ל-health, לחשבוניות ולמטא-דאטה; המותג החזותי מוגדר בקבצי הממשק.
AGENT_NAME=AI Workers

# One-line tagline for SEO and marketplace header.
# שורת תיאור קצרה ל-SEO ולכותרת המרקטפלייס.
AGENT_DESCRIPTION=AI employees for Israeli businesses

# Canonical public URL (no trailing slash). Render supplies RENDER_EXTERNAL_URL
# automatically, so leave this empty until a verified custom domain is used.
# כתובת קנונית; ב-Render אפשר להשאיר ריק עד לחיבור דומיין מותאם ומאומת.
PUBLIC_BASE_URL=

# Support / billing contact shown on payment pages and escalation emails.
# איש קשר לתמיכה וחיוב — מופיע בדפי התשלום ובמיילי הסלמה.
AGENT_OWNER_CONTACT=support@yourdomain.com

# --- LLM runtime / מנוע שפה -----------------------------------------------
# API key for OpenAI, Anthropic, Groq, Ollama gateway, etc.
# מפתח API ל-OpenAI, Anthropic, Groq, שער Ollama וכו'.
LLM_API_KEY=sk-...

# Provider: openai_compatible | anthropic
# ספק: openai_compatible | anthropic
LLM_PROVIDER=openai_compatible

# Model id — e.g. gpt-5.5, claude-sonnet-4-20250514
# מזהה מודל — למשל gpt-5.5, claude-sonnet-4-20250514
LLM_MODEL=gpt-5.5

# Base URL — leave empty for OpenAI default; set for Ollama/Groq/custom.
# כתובת בסיס — ריק לברירת מחדל של OpenAI; מלאו ל-Ollama/Groq/מותאם.
# Optional operator-controlled HTTPS endpoint. Tenants cannot override it.
LLM_BASE_URL=

# --- Payment channels / ערוצי תשלום -----------------------------------------
# At least one channel recommended for Israeli buyers.
# מומלץ לפחות ערוץ אחד לקונים בישראל.

# PayPal.Me username (without paypal.me/) — e.g. you → paypal.me/you
# שם משתמש PayPal.Me (בלי paypal.me/)
PAYPAL_ME=your-paypal-username

# Bit mobile number — Israeli format; keep the real number only in Render.
# מספר ביט — פורמט ישראלי; שמרו את המספר האמיתי רק ב-Render.
BIT_PHONE=9725XXXXXXXX

# --- Bank transfer (Israeli-friendly) / העברה בנקאית ------------------------
PAYEE_NAME=שם העסק / Your Business Ltd
BANK_NAME=Bank Hapoalim
BANK_BRANCH=620
BANK_ACCOUNT=123456
IBAN=
SWIFT=

# --- Admin / ניהול ---------------------------------------------------------
# Long random secret — protects /admin/*, /earnings, key issuance.
# סוד אקראי ארוך — מגן על /admin/*, /earnings והנפקת מפתחות.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Server / שרת -----------------------------------------------------------
# Render provides PORT; the Docker image defaults to 8765.
# Render מספק PORT; תמונת Docker משתמשת כברירת מחדל ב-8765.
PORT=8765
NODE_ENV=production

RATE_LIMIT_PER_MIN=120
SIGNUP_LIMIT_PER_HOUR=12

# --- Persistent disk paths / נתיבי דיסק קבוע -------------------------------
# Mount the Render persistent disk at /app/data.
# חברו את הדיסק הקבוע של Render בנתיב /app/data.
DB_PATH=/app/data/earnings.db
DATA_DIR=/app/data
TENANTS_DIR=/app/data/tenants
REQUIRE_PERSISTENT_VOLUME=1

# REQUIRED on Render — the app sits behind a trusted reverse proxy.
# חובה ב-Render — האפליקציה מאחורי reverse proxy מהימן.
TRUST_PROXY_HEADERS=1

# --- Trial & payments / ניסיון ותשלומים -----------------------------------
# Safe production default: no automatic free access. Change only after the
# business owner explicitly approves the offer and usage budget.
TRIAL_DAYS=0
PAYMENT_AUTO_VERIFY=0
BIT_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
ACTIVATION_SLA_HOURS=24

# --- Embeddable widget / וידג'ט מוטמע --------------------------------------
# Safe launch default: same-origin only. To embed on customer sites, set this to
# 1 and explicitly list approved HTTPS origins below (or * only intentionally).
EMBED_ALLOW_PUBLIC=0
EMBED_ALLOWED_ORIGINS=
# CORS_ALLOW_ORIGIN=https://your-frontend.com

# --- Webhooks & integrations / וובהוקים ואינטגרציות -----------------------
# Optional — POST JSON on new leads / escalations.
# אופציונלי — POST JSON על לידים חדשים / הסלמות.
WEBHOOK_NOTIFY_URL=

# Hebrew business hours hint for check_business_hours tool.
# רמז שעות פעילות בעברית לכלי check_business_hours.
# Example: א-ה 09:00-18:00, ו 09:00-13:00
BUSINESS_HOURS=א-ה 09:00-18:00, ו 09:00-13:00

# CORS — leave empty for same-origin; set only for a trusted separate frontend.
# CORS — השאירו ריק לאותו מקור; מלאו רק לפרונטאנד נפרד ומאומת.
CORS_ALLOW_ORIGIN=

# NEVER set to 1 in production — allows fetching localhost/private URLs.
# לעולם אל תגדירו 1 בפרודקשן — מאפשר גישה ל-localhost/רשת פרטית.
ALLOW_PRIVATE_NETWORK_URLS=0

# --- Integrations OAuth (platform-level — never in UI/code) ----------------
# Users click "Connect with Google/HubSpot/..." — tokens stored encrypted per tenant.
# Register redirect URI on each provider:
#   https://YOUR_PUBLIC_BASE_URL/api/integrations/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Encrypts per-tenant integration configs in SQLite (generate a long random string).
# Recovery only: preserve the exact old value. If it was previously unset, the
# old ADMIN_TOKEN was the fallback key and must be supplied here before restore.
INTEGRATIONS_SECRET=

# --- Paddle checkout (optional) / סליקת Paddle (אופציונלי) -----------------
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
# Optional JSON map from template/plan ids to Paddle price ids.
PADDLE_PRICE_MAP=
PADDLE_WEBHOOK_SECRET=
DEFAULT_RENT_DAYS=30

# Optional MCP preset server URLs (users connect via button, no paste).
MCP_PRESET_FILESYSTEM_URL=
MCP_PRESET_GITHUB_URL=

# --- WhatsApp (inbound + outbound) / WhatsApp --------------------------------
# See docs/WHATSAPP-ROADMAP.md
WHATSAPP_PROVIDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
