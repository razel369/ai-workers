# =============================================================================
# AI Workers — Production environment template
# תבנית משתני סביבה לפרודקשן
#
# Copy to Railway Dashboard → Variables (or your host's secret store).
# העתיקו ללוח הבקרה של Railway → Variables (או מאגר הסודות של הספק).
# Never commit real secrets. / לעולם אל תעלו סודות אמיתיים ל-Git.
# =============================================================================

# --- Identity / זהות -------------------------------------------------------
# Display name on landing, invoices, and worker UI.
# שם התצוגה בדף הבית, בחשבוניות ובממשק העובדים.
AGENT_NAME=AI Workers

# One-line tagline for SEO and marketplace header.
# שורת תיאור קצרה ל-SEO ולכותרת המרקטפלייס.
AGENT_DESCRIPTION=AI employees for Israeli businesses

# Canonical public URL — REQUIRED in production (no trailing slash).
# כתובת ציבורית קנונית — חובה בפרודקשן (בלי / בסוף).
# Railway example: https://your-service.up.railway.app
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Support / billing contact shown on invoice and escalation emails.
# איש קשר לתמיכה וחיוב — מופיע בחשבונית ובמיילי הסלמה.
AGENT_OWNER_CONTACT=support@yourdomain.com

# --- LLM runtime / מנוע שפה -----------------------------------------------
# API key for OpenAI, Anthropic, Groq, Ollama gateway, etc.
# מפתח API ל-OpenAI, Anthropic, Groq, שער Ollama וכו'.
LLM_API_KEY=sk-...

# Provider: openai_compatible | anthropic
# ספק: openai_compatible | anthropic
LLM_PROVIDER=openai_compatible

# Model id — e.g. gpt-5.5, claude-sonnet-4-20250514
# מזהה מודל — למשל gpt-5.5, claude-sonnet-4-20250514
LLM_MODEL=gpt-5.5

# Base URL — leave empty for OpenAI default; set for Ollama/Groq/custom.
# כתובת בסיס — ריק לברירת מחדל של OpenAI; מלאו ל-Ollama/Groq/מותאם.
LLM_BASE_URL=

# --- Payment channels / ערוצי תשלום -----------------------------------------
# At least one channel recommended for Israeli buyers.
# מומלץ לפחות ערוץ אחד לקונים בישראל.

# PayPal.Me username (without paypal.me/) — e.g. you → paypal.me/you
# שם משתמש PayPal.Me (בלי paypal.me/)
PAYPAL_ME=your-paypal-username

# Bit mobile number — Israeli format, e.g. 972541234567
# מספר ביט — פורמט ישראלי, למשל 972541234567
BIT_PHONE=972541234567

# Optional additional channels / ערוצים נוספים (אופציונלי)
BUY_ME_A_COFFEE=
KO_FI=
GITHUB_SPONSORS=
GUMROAD_URL=

# --- Bank invoice (Israeli-friendly) / חשבונית בנק --------------------------
PAYEE_NAME=שם העסק / Your Business Ltd
BANK_NAME=Bank Hapoalim
BANK_BRANCH=620
BANK_ACCOUNT=123456
IBAN=
SWIFT=

# --- Admin / ניהול ---------------------------------------------------------
# Long random secret — protects /admin/*, /earnings, key issuance.
# סוד אקראי ארוך — מגן על /admin/*, /earnings והנפקת מפתחות.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Server / שרת -----------------------------------------------------------
# Railway sets PORT automatically — do not override unless required.
# Railway מגדיר PORT אוטומטית — אל תדרסו אלא אם חובה.
PORT=8765

RATE_LIMIT_PER_MIN=120
SIGNUP_LIMIT_PER_HOUR=12

# --- Railway persistent volume paths / נתיבי ווליום קבוע ב-Railway ----------
# Mount a volume at /app/data in Railway Dashboard → Service → Volumes.
# חברו ווליום בנתיב /app/data ב-Railway Dashboard → Service → Volumes.
DB_PATH=/app/data/earnings.db
TENANTS_DIR=/app/data/tenants

# REQUIRED on Railway — app sits behind Railway's reverse proxy.
# חובה ב-Railway — האפליקציה מאחורי פרוקסי של Railway.
TRUST_PROXY_HEADERS=1

# --- Trial & payments / ניסיון ותשלומים -----------------------------------
TRIAL_DAYS=14
PAYMENT_AUTO_VERIFY=0
BIT_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
ACTIVATION_SLA_HOURS=24

# --- Embeddable widget / וידג'ט מוטמע --------------------------------------
EMBED_ALLOW_PUBLIC=1
# CORS_ALLOW_ORIGIN=https://your-website.com

# --- Webhooks & integrations / וובהוקים ואינטגרציות -----------------------
# Optional — POST JSON on new leads / escalations.
# אופציונלי — POST JSON על לידים חדשים / הסלמות.
WEBHOOK_NOTIFY_URL=

# Hebrew business hours hint for check_business_hours tool.
# רמז שעות פעילות בעברית לכלי check_business_hours.
# Example: א-ה 09:00-18:00, ו 09:00-13:00
BUSINESS_HOURS=א-ה 09:00-18:00, ו 09:00-13:00

# CORS — leave empty for same-origin; set only for a trusted separate frontend.
# CORS — השאירו ריק לאותו מקור; מלאו רק לפרונטאנד נפרד ומאומת.
CORS_ALLOW_ORIGIN=

# NEVER set to 1 in production — allows fetching localhost/private URLs.
# לעולם אל תגדירו 1 בפרודקשן — מאפשר גישה ל-localhost/רשת פרטית.
ALLOW_PRIVATE_NETWORK_URLS=

# --- Integrations OAuth (platform-level — never in UI/code) ----------------
# Users click "Connect with Google/HubSpot/..." — tokens stored encrypted per tenant.
# Register redirect URI on each provider:
#   https://YOUR_PUBLIC_BASE_URL/api/integrations/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Encrypts per-tenant integration configs in SQLite (generate a long random string).
INTEGRATIONS_SECRET=

# Optional MCP preset server URLs (users connect via button, no paste).
MCP_PRESET_FILESYSTEM_URL=
MCP_PRESET_GITHUB_URL=

# --- WhatsApp (inbound + outbound) / WhatsApp --------------------------------
# See docs/WHATSAPP-ROADMAP.md
WHATSAPP_PROVIDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# =============================================================================
# Recurring revenue, reliability and compliance
# See docs/REVENUE-OPERATIONS.md, docs/BACKUP-RESTORE.md, docs/COMPLIANCE.md
# =============================================================================

# --- Transactional email (REQUIRED for a working subscription business) ------
# Without this no renewal reminder, receipt, trial-expiry notice or lead alert
# can ever be sent, and customers churn silently on their renewal date.
# Pick ONE provider; MAIL_FROM is required in all cases.
MAIL_FROM=AI Workers <noreply@yourdomain.co.il>
MAIL_REPLY_TO=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# POSTMARK_TOKEN=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_WEBHOOK_URL=

# --- Billing lifecycle -------------------------------------------------------
BILLING_GRACE_DAYS=5            # keep answering this long past paid_until
BILLING_REMINDER_DAYS=7,3,1     # renewal reminder horizons
BILLING_RUN_HOUR=8
# BILLING_DISABLED=1

# --- Owner alerts (a lead at 23:00 must reach a phone, not a dashboard) ------
OWNER_ALERTS=1
OWNER_ALERT_MIN_SCORE=0
# OWNER_ALERT_QUIET_HOURS=23-7  # urgent escalations always override

# --- Usage metering + quotas (protects gross margin) ------------------------
QUOTA_ENFORCE=1                 # 0 = measure only, do not block
USD_TO_ILS=3.7
QUOTA_SOFT_WARN_PCT=80
# The message quota is a fair-use limit; this is the real margin guard. It also
# catches heavy-knowledge tenants running the full agent loop, which a message
# count cannot see.
PLAN_COST_CEILING_PCT=35        # cap LLM spend at this share of plan revenue
TRIAL_COST_CEILING_ILS=20       # free trials have no revenue to take a share of
LLM_DEFAULT_MODEL=deepseek-v4-flash
# LLM_DEFAULT_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# USD / 1M tokens. DeepSeek moved to peak/off-peak pricing on 16 Aug 2026 —
# off-peak is the default here, peak (01:00-04:00 & 06:00-10:00 UTC Mon-Fri)
# is roughly double. Verify against the live price list.
# MODEL_PRICING_JSON={"deepseek-v4-flash":{"in":0.22,"out":0.66,"cachedIn":0.007}}

# --- Chat model: DeepSeek V4 Flash -------------------------------------------
# DeepSeek is OpenAI-wire-compatible, so this goes through the same code path
# with a different host. LLM_API_KEY below is the DeepSeek key.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek caches repeated prompt prefixes automatically and bills hits at ~3%
# of the miss rate. This workload re-sends the same system prompt on every agent
# step, so most input tokens should come back as cache hits — check the
# `estimated` and cost columns in /api/admin/margin after a day of traffic.

# --- Images: GPT Image 2 (separate vendor, separate key) ---------------------
# NOT LLM_API_KEY — that one is DeepSeek's now. Without this the workers still
# answer normally but return mock placeholder images.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium     # low ~$0.03 | medium ~$0.05 | high ~$0.08 per image
MEDIA_IMAGE_PROVIDER=openai     # openai | google | mock
MEDIA_GEN_LIMIT_PER_MONTH=50    # per-tenant image/video cap
# IMAGE_PRICE_JSON={"medium":0.05}

# --- Backups (a volume loss is otherwise unrecoverable) ---------------------
BACKUP_ENABLED=1
BACKUP_DIR=/app/data/backups
BACKUP_KEEP_LOCAL=7
BACKUP_RUN_HOUR=3
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store this somewhere OTHER than the server it protects.
BACKUP_ENCRYPTION_KEY=
# Off-site is what makes it a backup — S3, Cloudflare R2, Backblaze B2, MinIO
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=prod

# --- Data retention + privacy ------------------------------------------------
RETENTION_ENABLED=1
RETENTION_DAYS=365
RETENTION_MIN_DAYS=30
NOTIFY_RETENTION_DAYS=90        # drop delivered notifications after this long

# --- Funnel analytics (first-party, no cookies) ------------------------------
FUNNEL_ANALYTICS=1
FUNNEL_RETENTION_DAYS=180

# --- WhatsApp production readiness -------------------------------------------
# Signature verification — without these the webhook is publicly forgeable and
# anyone can drive LLM spend on your account.
WHATSAPP_APP_SECRET=
# TWILIO_AUTH_TOKEN=            # doubles as the Twilio signing key
# Meta only allows free-form replies within 24h of the customer's last message.
# Outside that window an APPROVED Hebrew template is required.
WHATSAPP_SESSION_HOURS=24
WHATSAPP_TEMPLATE_LANG=he
WHATSAPP_TEMPLATE_REENGAGE=
WHATSAPP_TEMPLATE_LEAD_ALERT=

# --- Performance -------------------------------------------------------------
AGGREGATE_CACHE_MS=30000        # TTL for cross-tenant aggregate scans
