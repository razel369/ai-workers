# AI Workers — Oracle Cloud Always Free deployment template
# Copy to .env on the VM, replace every REPLACE_ME value, and chmod 600 .env.
# Never commit the real .env file.

# Free DNS hostname pointed at the VM's public IPv4 address.
# Example after creating a DuckDNS subdomain: ai-workers-il.duckdns.org
AI_WORKERS_DOMAIN=REPLACE_ME.duckdns.org

AGENT_NAME=AI Workers
AGENT_DESCRIPTION=AI employees for Israeli businesses
AGENT_OWNER_CONTACT=REPLACE_ME

# A real model still needs its own provider. To keep the whole stack at $0,
# select a provider/model with a genuine free quota and keep its usage limits on.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://REPLACE_ME
LLM_MODEL=REPLACE_ME
LLM_REQUEST_TIMEOUT_MS=30000

# Generate four different values on the VM:
#   openssl rand -hex 32
ADMIN_TOKEN=REPLACE_ME
INTEGRATIONS_SECRET=REPLACE_ME
BACKUP_ENCRYPTION_SECRET=REPLACE_ME
BACKUP_MANIFEST_SECRET=REPLACE_ME

# Configure at least one real payment channel before launch.
PAYPAL_ME=
BIT_PHONE=
PAYEE_NAME=
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT=
IBAN=
SWIFT=

# Safe production defaults. Do not relax these without an explicit decision.
TRIAL_DAYS=0
PAYMENT_AUTO_VERIFY=0
EMBED_ALLOW_PUBLIC=0
EMBED_SESSION_IP_WORKER_HOURLY=20
EMBED_SESSION_WORKER_HOURLY=200
EMBED_CHAT_SESSION_HOURLY=60
EMBED_CHAT_IP_WORKER_HOURLY=120
EMBED_CHAT_WORKER_HOURLY=500
EMBED_ALLOWED_ORIGINS=
EMBED_SESSION_TTL_MINUTES=60
ALLOW_PRIVATE_NETWORK_URLS=0
RATE_LIMIT_PER_MIN=120
MAX_WORKERS_PER_TENANT=25
SIGNUP_LIMIT_PER_HOUR=12
MONTHLY_CHAT_LIMIT=2000
MONTHLY_PROVIDER_CALL_LIMIT=2000
OWNER_SESSION_TTL_DAYS=30
PRODUCT_ANALYTICS=1
PRODUCT_ANALYTICS_RETENTION_DAYS=90
CUSTOMER_DATA_RETENTION_DAYS=180

# Optional off-VM backup destination configured with `sudo rclone config`.
# Example: encrypted-gdrive:ai-workers-production
BACKUP_RCLONE_REMOTE=
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_REMOTE_RETENTION_DAYS=90

# Optional HTTPS webhook for state-change alerts from deploy/oci/monitor.sh.
MONITOR_ALERT_WEBHOOK_URL=
BACKUP_MAX_AGE_HOURS=48

# Optional notifications and integrations.
WEBHOOK_NOTIFY_URL=
BUSINESS_HOURS=א-ה 09:00-18:00, ו 09:00-13:00
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Optional billing/webhook providers.
BIT_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# Required JSON map for every template offered at checkout; no default fallback.
PADDLE_PRICE_MAP=
PADDLE_WEBHOOK_SECRET=
DEFAULT_RENT_DAYS=30

# Optional WhatsApp integration.
WHATSAPP_PROVIDER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
